BIND_HOST=127.0.0.1
PORT=8000
PAIRING_TOKEN=change-me
AUDIT_LOG_PATH=./audit.jsonl
CMD_TIMEOUT_SECONDS=10

# On Render, TLS terminates at the proxy. TouchDesigner should connect with
# wss://<service>.onrender.com/ws — never put a real secret in this file.
# Render also sets PORT and RENDER for you; set PAIRING_TOKEN and BIND_HOST=0.0.0.0.
